  X-CMP-User-GID: {{userGid}}
  X-CMP-Project-ID: {{projectId}}
  Project-ID: {{projectId}}
}

docs {
  GET /apis/v2beta1/artifacts/{artifact_id}
  Returns a single MLMD artifact by its numeric ID.

