meta {
  name: Get pipeline version
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/apis/v2beta1/pipelines/{{pipelineId}}/versions/{{pipelineVersionId}}
  body: none
  auth: none
}

headers {
  X-Region: {{region}}
  X-CMP-User-GID: {{userGid}}
  X-CMP-Project-ID: {{projectId}}
  Project-ID: {{projectId}}
}
