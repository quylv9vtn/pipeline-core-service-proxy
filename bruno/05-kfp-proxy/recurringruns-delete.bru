meta {
  name: Delete recurring run
  type: http
  seq: 29
}

delete {
  url: {{baseUrl}}/apis/v2beta1/recurringruns/{{recurringRunId}}
  body: none
  auth: none
}

headers {
  X-Region: {{region}}
  X-CMP-User-GID: {{userGid}}
  X-CMP-Project-ID: {{projectId}}
  Project-ID: {{projectId}}
}

docs {
  DELETE /apis/v2beta1/recurringruns/{recurring_run_id}
  Without ?cascade=true: returns 409 Conflict if the recurring run has associated runs.
  With ?cascade=true: deletes all associated runs first, then deletes the recurring run.
  See recurringruns-patch.bru to update display_name / description instead.
}
