meta {
  name: Create recurring run
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/apis/v2beta1/recurringruns
  body: json
  auth: none
}

headers {
  X-Region: {{region}}
  X-CMP-User-GID: {{userGid}}
  X-CMP-Project-ID: {{projectId}}
  Project-ID: {{projectId}}
}

body:json {
  {
    "display_name": "demo-recurring-d1",
    "experiment_id": "{{experimentId}}",
    "mode": "ENABLE",
    "no_catchup": true,
    "max_concurrency": 1,
    "trigger": {
      "cron_schedule": {
        "cron": "*/3 * * * *"
      }
    },
    "pipeline_version_reference": {
      "pipeline_id": "{{pipelineId}}",
      "pipeline_version_id": "{{pipelineVersionId}}"
    },
    "runtime_config": {
      "parameters": {
        "message": "hello recurring"
      }
    },
    "service_account": "pipeline-runner"
  }
}

docs {
  KFP v2beta1 RecurringRun shape (backend/api/v2beta1/recurring_run.proto):
  display_name, experiment_id, mode, enabled, no_catchup, max_concurrent_run_count,
  trigger {cron_schedule {cron} | periodic_schedule {interval_second}},
  pipeline_version_reference {pipeline_id, pipeline_version_id},
  runtime_config.parameters, service_account.
  The gateway injects the top-level "namespace" field; the body is otherwise
  a pass-through.
}
