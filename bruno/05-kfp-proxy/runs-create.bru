meta {
  name: Create run
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/apis/v2beta1/runs
  body: json
  auth: none
}

headers {
  X-Region: {{region}}
  X-CMP-User-GID: {{userGid}}
  X-CMP-Project-ID: {{projectId}}
  Project-ID: {{projectId}}
}

body:json {
  {
    "display_name": "",
    "experiment_id": "{{experimentId}}",
    "pipeline_version_reference": {
      "pipeline_id": "{{pipelineId}}",
      "pipeline_version_id": "{{pipelineVersionId}}"
    },
    "runtime_config": {
      "parameters": {
        "message": "hello run"
      }
    },
    "service_account": "pipeline-runner"
  }
}

docs {
  KFP v2beta1 Run shape (backend/api/v2beta1/run.proto):
  display_name, pipeline_version_reference {pipeline_id, pipeline_version_id},
  runtime_config.parameters (map<string, Value>), service_account.
  The gateway does NOT transform this body — it is a pass-through proxy.
  No namespace injection: KFP derives it from experiment_id — the experiment
  must belong to the calling project (namespace check applies to the GET).
}
