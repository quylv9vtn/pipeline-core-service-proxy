meta {
  name: Upload pipeline version
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/apis/v2beta1/pipelines/upload_version
  body: multipart-form
  auth: none
}

headers {
  X-Region: {{region}}
  X-CMP-User-GID: {{userGid}}
  X-CMP-Project-ID: {{projectId}}
  Project-ID: {{projectId}}
}

body:multipart-form {
  uploadfile: @file(hello-world.yaml)
  display_name: hello-world-v2
  pipeline_id: {{pipelineId}}
  steps: {"hello-world": {"flavor_id": "{{flavorId}}", "image_id": "{{imageId}}"}}
}

docs {
  No namespace injection (the version inherits the parent pipeline's).
  - display_name: must be UNIQUE among the versions of THIS pipeline — a
    duplicate returns 409 {"error": "display_name_already_exists"}. Send
    display_name only: the gateway generates the technical version name as
    slug(display_name)+random. A "name" field is rejected with 400
    name_not_supported.
  - pipeline_id: FORM FIELD — the gateway promotes it to KFP's ?pipelineid=
    query param. It must belong to the calling project.
}
