meta {
  name: Admin create flavor (GPU)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/apis/v2beta1/admin/flavors
  body: json
  auth: none
}

headers {
  X-Service-Key: {{serviceKey}}
}

body:json {
  {
    "name": "gpu-rtx2080-2x",
    "description": "2x RTX 2080, 16 vCPU, 64 GiB",
    "region_name": "{{region}}",
    "cpu": 16,
    "memory_gib": 64,
    "gpu_model": "ai_rtx2080",
    "gpu_count": 2,
    "status": "enabled"
  }
}

docs {
  gpu_model must be "ai_rtx2080" or "ai_h200". gpu_model and gpu_count must
  both be set or both be empty. Server assigns id (UUID).
}
