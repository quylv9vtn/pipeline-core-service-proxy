meta {
  name: Admin create flavor (CPU)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/apis/v2beta1/admin/flavors
  body: json
  auth: none
}

headers {
  X-Service-Key: {{serviceKey}}
}

body:json {
  {
    "name": "cpu-small",
    "description": "100m CPU, 100MiB Mem, no GPU",
    "region_name": "{{region}}",
    "cpu_milli": 100,
    "memory_mib": 100
  }
}

docs {
  CPU-only flavor: omit gpu_model and gpu_count entirely (both empty).
  Units: cpu_milli in millicores (2000 = 2 vCPU), memory_mib in MiB (8192 = 8 GiB).
}
