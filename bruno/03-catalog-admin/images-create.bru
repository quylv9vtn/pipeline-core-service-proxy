meta {
  name: Admin create image
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/apis/v2beta1/admin/images
  body: json
  auth: none
}

headers {
  X-Service-Key: {{serviceKey}}
}

body:json {
  {
    "name": "python-3.11",
    "description": "Python image",
    "region_name": "{{region}}",
    "version": "3.11",
    "image_url": "harbor-local.aiplatformdev.freeddns.org/ai-platform/python:3.11",
    "status": "enabled"
  }
}

docs {
  Unique per region: (region_name, name, version). Server assigns id (UUID).
}
